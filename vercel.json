{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/products/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/product/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/materials/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/material/assets/:path*", "destination": "/assets/:path*" },
    { "source": "/products/logo/:path*", "destination": "/logo/:path*" },
    { "source": "/product/logo/:path*", "destination": "/logo/:path*" },
    { "source": "/materials/logo/:path*", "destination": "/logo/:path*" },
    { "source": "/material/logo/:path*", "destination": "/logo/:path*" },
    { "source": "/products", "destination": "/product-materials" },
    { "source": "/products/:path*", "destination": "/product-materials" },
    { "source": "/product", "destination": "/product-materials" },
    { "source": "/product/:path*", "destination": "/product-materials" },
    { "source": "/materials", "destination": "/product-materials" },
    { "source": "/materials/:path*", "destination": "/product-materials" },
    { "source": "/material", "destination": "/product-materials" },
    { "source": "/material/:path*", "destination": "/product-materials" },
    { "source": "/certificates", "destination": "/certificate" },
    { "source": "/certificates/:path*", "destination": "/certificate" },
    { "source": "/rfq", "destination": "/get-quote" },
    { "source": "/rfq/:path*", "destination": "/get-quote" }
  ]
}
